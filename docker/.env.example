# Copy this file to docker/.env and fill in real values before running docker compose.
# Never commit the real .env file - it will contain secrets.

# --------------------------------------------------------------------------------------------
# Embedding provider: choose ONE of AzureOpenAI or Local via EMBEDDING_PROVIDER.
# --------------------------------------------------------------------------------------------
EMBEDDING_PROVIDER=Local

# Azure OpenAI (used when EMBEDDING_PROVIDER=AzureOpenAI)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=changeme
AZURE_OPENAI_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_DIMENSIONS=3072

# Local OpenAI-compatible embedding server (used when EMBEDDING_PROVIDER=Local), e.g. Ollama,
# vLLM, or llama.cpp's server. host.docker.internal lets the container reach a model server
# running on the Docker host itself.
LOCAL_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_EMBEDDING_MODEL=bge-m3
LOCAL_EMBEDDING_DIMENSIONS=1024
LOCAL_EMBEDDING_API_KEY=

# Optional local cross-encoder reranker endpoint (leave blank to disable reranking).
RERANKER_BASE_URL=
RERANKER_MODEL=bge-reranker-v2-m3

# --------------------------------------------------------------------------------------------
# Qdrant
# --------------------------------------------------------------------------------------------
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=cryptex_chunks

# --------------------------------------------------------------------------------------------
# At-rest encryption key for retained original file bytes / chunk text (AES-256-GCM).
# Generate one with: openssl rand -base64 32
# --------------------------------------------------------------------------------------------
CRYPTEX_AT_REST_KEY=changeme-generate-a-real-base64-256-bit-key

RETAIN_ORIGINALS=false

# --------------------------------------------------------------------------------------------
# Customer-encrypted source files ("envelopes").
#
# For a corpus that your OWN C# code encrypted by running AES-CBC over the raw file bytes and
# writing the IV in front of the ciphertext (blob layout: IV || ciphertext). Cryptex decrypts
# these in memory, works out what the plaintext really is, and hands it to the normal parsers.
#
# This is NOT the same thing as a password-protected Office file, and NOT the same thing as
# CRYPTEX_AT_REST_KEY above. See the README section "Three distinct kinds of encryption".
# --------------------------------------------------------------------------------------------
ENVELOPE_ENABLED=false
ENVELOPE_IV_LENGTH=16
ENVELOPE_PADDING_MODE=Pkcs7          # Pkcs7 | None (None for hand-rolled zero-padding)
ENVELOPE_DEFAULT_KEY_ID=default

# One variable per key id: CRYPTEX_ENVELOPE_KEY_<keyId>. Key material NEVER goes in
# appsettings.json. Base64 of 16, 24 or 32 raw bytes (AES-128/192/256).
# Generate one with: openssl rand -base64 32
CRYPTEX_ENVELOPE_KEY_default=changeme-generate-a-real-base64-aes-key
# Add more ids for key rotation, e.g.:
# CRYPTEX_ENVELOPE_KEY_2024=changeme-generate-a-real-base64-aes-key

# Optional encrypt-then-MAC verification. STRONGLY RECOMMENDED whenever your encryptor emits a
# MAC: unauthenticated CBC is malleable, and the MAC is checked before any decryption happens.
ENVELOPE_HMAC_ENABLED=false
ENVELOPE_HMAC_ALGORITHM=HMACSHA256   # HMACSHA256 | HMACSHA384 | HMACSHA512 | HMACSHA1
ENVELOPE_HMAC_PLACEMENT=Append       # Append (IV||ct||MAC) | Prepend (MAC||IV||ct)
ENVELOPE_HMAC_LENGTH=0               # 0 = the algorithm's full output size
CRYPTEX_ENVELOPE_HMAC_KEY=changeme-generate-a-real-base64-mac-key
